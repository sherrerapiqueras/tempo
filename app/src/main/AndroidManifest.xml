<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".TempoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Tempo">
        <!--
            tools:ignore="Instantiatable" — false positive: MainActivity extends
            ComponentActivity (a subclass of Activity), but lint cannot resolve
            the chain in some setups when Hilt's @AndroidEntryPoint rewrites the
            generated superclass. Track removal once lint catches up.
        -->
        <!--
            configChanges: size, layout and orientation changes (rotation, folding, split screen,
            desktop window resizing) are handled in place rather than by recreating the activity.
            The UI is Compose throughout and lays itself out from the current window size, with
            no orientation- or size-qualified resources to reload; staying alive keeps animations
            running across the change, so the layout glides to its new shape (#163). Night mode
            too: the app's colours come from Compose's theme, and handing the chosen theme to the
            system (#513) would otherwise restart the screen on every change in Settings. Density
            and locale changes still recreate, as they should.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Tempo.Splash"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".infrastructure.reminders.receivers.TaskReminderReceiver"
            android:exported="false"
            android:enabled="true" />
        <receiver
            android:name=".infrastructure.reminders.receivers.HabitReminderReceiver"
            android:exported="false"
            android:enabled="true" />
        <receiver
            android:name=".infrastructure.reminders.receivers.MarkAsCompletedReceiver"
            android:exported="false"
            android:enabled="true" />
        <receiver
            android:name=".infrastructure.reminders.receivers.MarkHabitAsCompletedReceiver"
            android:exported="false"
            android:enabled="true" />
        <receiver
            android:name=".infrastructure.reminders.receivers.StartHabitChainReceiver"
            android:exported="false"
            android:enabled="true" />
        <receiver
            android:name=".infrastructure.reminders.receivers.CompleteHabitReceiver"
            android:exported="false"
            android:enabled="true" />
        <receiver
            android:name=".infrastructure.reminders.receivers.DismissLiveActivityReceiver"
            android:exported="false"
            android:enabled="true" />
        <receiver
            android:name=".infrastructure.reminders.receivers.MissedReminderCatchUpReceiver"
            android:exported="false"
            android:enabled="true" />

        <receiver
            android:name=".infrastructure.focus.FocusSessionEndReceiver"
            android:exported="false" />

        <receiver
            android:name=".infrastructure.focus.FocusSessionActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".infrastructure.focus.StartFocusSessionReceiver"
            android:exported="false" />

        <receiver
            android:name=".infrastructure.reminders.receivers.BootAndTimeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".features.widget.presentation.QuickAddTaskWidgetReceiver"
            android:label="@string/widget_quick_add_task_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_task_widget_info" />
        </receiver>

        <!-- Hands one task attachment at a time to a viewer app (#380). -->
        <provider
            android:name=".infrastructure.attachments.AttachmentFileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attachment_paths" />
        </provider>

        <!-- Disable default WorkManager Initializer to use Hilt configuration -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>