<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview of the Today widget for Android 12-14 launchers (Android 15+ get one
     generated from the real layout by TodayWidgetUpdater). Mirrors TodayWidgetContent's full size:
     header strip, connected cards, add button. Colours: values-v31/widget_preview_colors.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_single"
    android:backgroundTint="@color/widget_preview_background"
    android:orientation="vertical"
    android:padding="10dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_today_label"
            android:textColor="@color/widget_preview_text"
            android:textSize="22sp" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_card_single"
            android:backgroundTint="@color/widget_preview_add"
            android:contentDescription="@string/add_task"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            android:tint="@color/widget_preview_on_add" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:background="@drawable/widget_card_first"
        android:backgroundTint="@color/widget_preview_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_check_idle"
            android:tint="@color/widget_preview_check" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_task_plan"
                android:textColor="@color/widget_preview_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="09:00"
                android:textColor="@color/widget_preview_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_card_last"
        android:backgroundTint="@color/widget_preview_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_check_idle"
            android:tint="@color/widget_preview_check" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_task_call"
                android:textColor="@color/widget_preview_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="13:30"
                android:textColor="@color/widget_preview_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
